# Configuration reference: docs/configuration.md

# Copy to .env and fill in. Everything is optional except SABLE_BOT_SECRET.

# --- Talk bot identity -------------------------------------------------------
# The secret you passed to `occ talk:bot:install` (40-128 characters).
# Generate one with: openssl rand -hex 32
SABLE_BOT_SECRET=

# Name used for mention detection: "@sable what's the status" triggers the model.
SABLE_BOT_NAME=sable

# Your Nextcloud base URL, no trailing slash. Optional for the webhook path
# (the signed X-Nextcloud-Talk-Backend header carries it), required if you
# enable the /notify endpoint.
SABLE_NEXTCLOUD_URL=https://cloud.example.org

# Reject webhooks whose backend header is not SABLE_NEXTCLOUD_URL. Ignored when
# no URL is configured.
SABLE_PIN_BACKEND=true

# --- Chat behaviour ----------------------------------------------------------
SABLE_COMMAND_PREFIX=!

# Conversations where every message goes to the model, no mention needed.
# Accepts conversation tokens (a1b2c3d4, from the conversation's URL) or display
# names (AI), or * for all of them. Empty = mentions and !ai only.
# Tokens never change; a moderator can rename a conversation at any time.
SABLE_AI_ROOMS=

# Post answers as threaded replies to the triggering message.
SABLE_REPLY_AS_REPLY=false

# Emoji to stick on a message while the model is thinking; empty disables it.
SABLE_THINKING_REACTION=

# React to any message with this emoji and the bot sends that message to the
# model and answers it, threaded under the original. Empty disables the feature
# and the message cache it depends on. Requires --feature reaction at install.
SABLE_ASK_REACTION=⁉️

# How many recent messages to remember per conversation, so a reaction can name
# one. A reaction event carries only the message id, never the text, so this is
# what makes the feature possible. Only populated while SABLE_ASK_REACTION is
# set, and it expires with SABLE_HISTORY_TTL.
SABLE_MESSAGE_CACHE=200

# Post a short "I have no such command" hint on unknown commands.
SABLE_UNKNOWN_COMMAND_HINT=true

# Post failures back into the conversation instead of only logging them.
SABLE_REPORT_ERRORS=true

# Call Nextcloud's status.php at startup and log what answered, so a wrong URL or
# an untrusted certificate is obvious at boot rather than on the first reply
# somebody is waiting for. Never fatal; needs SABLE_NEXTCLOUD_URL.
SABLE_STARTUP_CHECK=true

# Talk hard-rejects messages over 32000 characters.
SABLE_MAX_MESSAGE_CHARS=30000

# Users the bot ignores completely. Nothing they say or react to is acted on,
# and their messages are never cached for the ⁉️ feature. Comma-separated; each
# entry matches a bare user id (alice), a full actor id (users/alice, which is
# what the log prints), or a display name. Ids are stable; a display name can be
# changed by the person themselves, which would quietly un-ignore them.
SABLE_IGNORE_USERS=

# --- Conversation memory (in-process, lost on restart) -----------------------
SABLE_HISTORY_TURNS=12
SABLE_HISTORY_TTL=3600

# --- Model: any OpenAI /chat/completions-compatible endpoint -----------------
# OpenAI:     https://api.openai.com/v1
# Ollama:     http://localhost:11434/v1
# vLLM:       http://localhost:8000/v1
# LiteLLM:    http://localhost:4000/v1
# OpenRouter: https://openrouter.ai/api/v1
SABLE_LLM_BASE_URL=https://api.openai.com/v1
SABLE_LLM_API_KEY=
# Leave SABLE_LLM_MODEL empty to run commands only, with no model at all.
SABLE_LLM_MODEL=
SABLE_LLM_SYSTEM_PROMPT=
SABLE_LLM_TEMPERATURE=
SABLE_LLM_MAX_TOKENS=
SABLE_LLM_TIMEOUT=120
# Provider-specific fields merged into the request body; these win over the above.
SABLE_LLM_EXTRA_BODY={}

# --- Inbound alerting endpoint (POST /notify) --------------------------------
# Empty disables the endpoint entirely (it then answers 404).
SABLE_NOTIFY_TOKEN=
# Friendly names so callers need not know conversation tokens:
#   SABLE_NOTIFY_ROOMS=alerts=a1b2c3d4,deploys=e5f6g7h8
SABLE_NOTIFY_ROOMS=

# --- Webhooks from other services --------------------------------------------
# Services that cannot speak the /notify shape post to /hook/<name> instead.
# Hook name to conversation; the conversation is a token - the lowercase string
# at the end of its URL, not the room's name - or a SABLE_NOTIFY_ROOMS alias.
# Empty means every /hook/... answers 404.
#   SABLE_HOOKS=komodo=a1b2c3d4,grafana=e5f6g7h8
SABLE_HOOKS=

# Each hook needs its own token, in its own variable. A hook without one, or a
# token without a hook, is a startup error.
#   SABLE_HOOK_TOKEN_KOMODO=...

# Optional per-hook format string. Without one the payload is rendered
# generically, which is usually good enough to start with.
#   SABLE_HOOK_TEMPLATE_KOMODO=**{level}** {data.type}: {data.data.name}

# Largest webhook payload accepted, in bytes. Default 256 KiB.
SABLE_MAX_HOOK_BYTES=262144

# --- File attachments on /notify ---------------------------------------------
# The Talk bot API cannot attach files, so this takes a second credential: an
# ordinary Nextcloud user with an app password. Leave both empty and /notify
# stays text-only. This account can read and write its own Files -- a much
# larger credential than the bot secret, so give it its own user.
SABLE_NEXTCLOUD_USER=
SABLE_NEXTCLOUD_PASSWORD=

# Folder inside that user's Files where attachments are put before sharing.
SABLE_UPLOAD_PATH=/sable

# Largest attachment /notify will accept, in bytes. Default 25 MiB.
SABLE_MAX_UPLOAD_BYTES=26214400

# --- Read by docker compose, not by sable ------------------------------------
# The host directory holding your CA bundle, mounted read-only so the bot can
# verify a Nextcloud using an internal or self-signed certificate. RHEL and
# Fedora keep it at /etc/pki/tls/certs. See docs/deployment.md.
SABLE_HOST_CA_DIR=/etc/ssl/certs

# --- Process -----------------------------------------------------------------
SABLE_HOST=0.0.0.0
SABLE_PORT=8080
SABLE_LOG_LEVEL=INFO
