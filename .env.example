# Configuration reference: docs/configuration.md

# Copy to .env and fill in. Everything is optional except SABLE_BOT_SECRET.

# --- Talk bot identity -------------------------------------------------------
# The secret you passed to `occ talk:bot:install` (40-128 characters).
# Generate one with: openssl rand -hex 32
SABLE_BOT_SECRET=

# The secret you are rotating away from, accepted on incoming webhooks only and
# never used to sign anything sable sends. Talk holds one secret per bot install,
# so changing it means `occ talk:bot:uninstall`, installing again with the new
# value, then restarting - and every event that arrives in between fails its
# signature check. Set this to the old value for that window, then clear it.
# Same 40-128 characters, and it may not repeat SABLE_BOT_SECRET.
SABLE_BOT_SECRET_PREVIOUS=

# Name used for mention detection: "@sable what's the status" triggers the model.
SABLE_BOT_NAME=sable

# Your Nextcloud base URL, no trailing slash. Optional for the webhook path
# (the signed X-Nextcloud-Talk-Backend header carries it), required if you
# enable the /notify endpoint.
SABLE_NEXTCLOUD_URL=https://cloud.example.org

# Reject webhooks whose backend header is not SABLE_NEXTCLOUD_URL. Ignored when
# no URL is configured.
SABLE_PIN_BACKEND=true

# --- Chat behaviour ----------------------------------------------------------
SABLE_COMMAND_PREFIX=!

# Conversations where every message goes to the model, no mention needed.
# Accepts conversation tokens (a1b2c3d4, from the conversation's URL) or display
# names (AI), or * for all of them. Empty = mentions and !ai only.
# Tokens never change; a moderator can rename a conversation at any time.
SABLE_AI_ROOMS=

# Post answers as threaded replies to the triggering message.
SABLE_REPLY_AS_REPLY=false

# Emoji to stick on a message while the model is thinking; empty disables it.
SABLE_THINKING_REACTION=

# React to any message with this emoji and the bot sends that message to the
# model and answers it, threaded under the original. Empty disables the feature
# and the message cache it depends on. Requires --feature reaction at install.
SABLE_ASK_REACTION=⁉️

# Let only SABLE_ADMIN_USERS use that reaction. Otherwise anyone in the room can
# forward somebody else's message to the model backend without saying a word in
# the room. Setting this with no SABLE_ADMIN_USERS is a startup error, since it
# would leave the feature usable by nobody.
SABLE_ASK_ADMINS_ONLY=false

# Conversations whose messages are cached for that reaction. Same identifiers as
# SABLE_AI_ROOMS - tokens (a1b2c3d4) or display names, or * for all.
# NOTE THE ASYMMETRY: empty here means EVERY conversation, where an empty
# SABLE_AI_ROOMS means none. Deliberate - empty is what every deployment already
# has, and reading it as "no rooms" would silently switch the reaction off on
# upgrade. Name the rooms that use the feature and the rest stop being cached,
# which costs less memory and leaves less chat content in the process.
SABLE_ASK_ROOMS=

# How many recent messages to remember per conversation, so a reaction can name
# one. A reaction event carries only the message id, never the text, so this is
# what makes the feature possible. Only populated while SABLE_ASK_REACTION is
# set, and it expires with SABLE_HISTORY_TTL.
SABLE_MESSAGE_CACHE=200

# Post a short "I have no such command" hint on unknown commands.
SABLE_UNKNOWN_COMMAND_HINT=true

# Post failures back into the conversation instead of only logging them.
SABLE_REPORT_ERRORS=true

# Call Nextcloud's status.php at startup and log what answered, so a wrong URL or
# an untrusted certificate is obvious at boot rather than on the first reply
# somebody is waiting for. Never fatal; needs SABLE_NEXTCLOUD_URL.
SABLE_STARTUP_CHECK=true

# Talk hard-rejects messages over 32000 characters.
SABLE_MAX_MESSAGE_CHARS=30000

# How many model calls may be in flight at once; 0 means no ceiling. Every
# trigger is handled in a background task with no limit of its own, so a busy
# room or a burst of redelivered webhooks means that many completions open
# together, each holding SABLE_LLM_TIMEOUT seconds. Talk rate-limits the replies
# sable sends, not the events it sends sable, so nothing upstream applies the
# brakes. Lower it for a local model that serves one request at a time.
SABLE_MAX_CONCURRENT_REPLIES=8

# Users the bot ignores completely. Nothing they say or react to is acted on,
# and their messages are never cached for the ⁉️ feature. Comma-separated; each
# entry matches a bare user id (alice), a full actor id (users/alice, which is
# what the log prints), or a display name. Ids are stable; a display name can be
# changed by the person themselves, which would quietly un-ignore them.
SABLE_IGNORE_USERS=

# Commands only the people in SABLE_ADMIN_USERS may run. Comma-separated. Every
# command not named here stays open to everyone in the conversation, guests
# included, which is the default for all of them. `*` closes every command and
# makes SABLE_NORMAL_COMMANDS the list of exceptions. Naming a command restricts
# its aliases with it, so `reset` also covers `!forget`.
#   SABLE_ADMIN_COMMANDS=reset,ai
SABLE_ADMIN_COMMANDS=

# The exceptions to SABLE_ADMIN_COMMANDS=*, open to everyone. Redundant
# otherwise - it only writes the default down where an operator can see it.
#   SABLE_NORMAL_COMMANDS=help,ping,whoami
SABLE_NORMAL_COMMANDS=

# Who may run the admin commands. Nextcloud user ids, comma-separated; a full
# actor id (users/maser) works too. Unlike SABLE_IGNORE_USERS this never matches
# a display name: anybody can set theirs to yours. Guests have no user id and so
# are never administrators. Required if SABLE_ADMIN_COMMANDS is set.
#   SABLE_ADMIN_USERS=maser,korren
SABLE_ADMIN_USERS=

# --- Conversation memory (in-process, lost on restart) -----------------------
SABLE_HISTORY_TURNS=12
SABLE_HISTORY_TTL=3600

# --- Model: any OpenAI /chat/completions-compatible endpoint -----------------
# OpenAI:     https://api.openai.com/v1
# Ollama:     http://localhost:11434/v1
# vLLM:       http://localhost:8000/v1
# LiteLLM:    http://localhost:4000/v1
# OpenRouter: https://openrouter.ai/api/v1
SABLE_LLM_BASE_URL=https://api.openai.com/v1
SABLE_LLM_API_KEY=
# Leave SABLE_LLM_MODEL empty to run commands only, with no model at all.
SABLE_LLM_MODEL=
SABLE_LLM_SYSTEM_PROMPT=
SABLE_LLM_TEMPERATURE=
SABLE_LLM_MAX_TOKENS=
SABLE_LLM_TIMEOUT=120
# Provider-specific fields merged into the request body; these win over the
# above. It may not set stream or messages, which sable builds itself.
SABLE_LLM_EXTRA_BODY={}

# --- Letting the model use tools ---------------------------------------------
# openai is one request and one answer, against anything that speaks chat
# completions; a model that asks for a tool gets no answer, because nobody runs
# it. openwebui hands the whole loop to Open WebUI, which executes tools with
# the API key's own permissions and writes the answer into a chat record.
# Requires SABLE_LLM_API_KEY, and SABLE_LLM_BASE_URL ending in /api.
SABLE_LLM_BACKEND=openai

# Workspace tools and MCP servers, named as Open WebUI names them.
#   SABLE_LLM_TOOL_IDS=server:mcp:1,server:mcp:2

# Open WebUI's own built-ins: web_search, code_interpreter, image_generation,
# memory. Needs SABLE_LLM_BUILTIN_TOOLS on.
#   SABLE_LLM_FEATURES=web_search

# Off uses the blocking variant: one request that waits for the loop to finish,
# with no polling - but no built-in tools either.
SABLE_LLM_BUILTIN_TOOLS=true

# Seconds between checks while the loop is running.
SABLE_LLM_POLL_INTERVAL=2.0

# Keep the conversation each question creates. It exists only because the loop
# needs somewhere to write; by default it is deleted afterwards.
SABLE_LLM_KEEP_CHATS=false

# Append what the answer cited. Worth having: it is how you notice an answer
# came from an encyclopaedia rather than from today's market.
SABLE_LLM_SHOW_SOURCES=false

# --- Inbound alerting endpoint (POST /notify) --------------------------------
# Empty disables the endpoint entirely (it then answers 404).
SABLE_NOTIFY_TOKEN=
# Friendly names so callers need not know conversation tokens:
#   SABLE_NOTIFY_ROOMS=alerts=a1b2c3d4,deploys=e5f6g7h8
SABLE_NOTIFY_ROOMS=

# --- Webhooks from other services --------------------------------------------
# Services that cannot speak the /notify shape post to /hook/<name> instead.
# Hook name to conversation; the conversation is a token - the lowercase string
# at the end of its URL, not the room's name - or a SABLE_NOTIFY_ROOMS alias.
# Empty means every /hook/... answers 404.
#   SABLE_HOOKS=komodo=a1b2c3d4,grafana=e5f6g7h8
SABLE_HOOKS=

# Each hook needs its own token, in its own variable. A hook without one, or a
# token without a hook, is a startup error.
#   SABLE_HOOK_TOKEN_KOMODO=...

# Optional per-hook format string. Without one the payload is rendered
# generically, which is usually good enough to start with.
#   SABLE_HOOK_TEMPLATE_KOMODO=**{level}** {data.type}: {data.data.name}

# Largest webhook payload accepted, in bytes. Default 256 KiB.
SABLE_MAX_HOOK_BYTES=262144

# --- File attachments on /notify ---------------------------------------------
# The Talk bot API cannot attach files, so this takes a second credential: an
# ordinary Nextcloud user with an app password. Leave both empty and /notify
# stays text-only. This account can read and write its own Files -- a much
# larger credential than the bot secret, so give it its own user.
SABLE_NEXTCLOUD_USER=
SABLE_NEXTCLOUD_PASSWORD=

# Folder inside that user's Files where attachments are put before sharing.
SABLE_UPLOAD_PATH=/sable

# Largest attachment /notify will accept, in bytes. Default 25 MiB.
SABLE_MAX_UPLOAD_BYTES=26214400

# --- Read by docker compose, not by sable ------------------------------------
# The host directory holding your CA bundle, mounted read-only so the bot can
# verify a Nextcloud using an internal or self-signed certificate. RHEL and
# Fedora keep it at /etc/pki/tls/certs. See docs/deployment.md.
SABLE_HOST_CA_DIR=/etc/ssl/certs

# --- The HTTP surface itself -------------------------------------------------
# Serve FastAPI's generated schema at /openapi.json and the doc pages built from
# it at /docs and /redoc. Off by default: they describe every route, header and
# body shape to anybody who can reach the service, and nothing needs them at
# runtime. Off removes the routes entirely - they answer 404, not 401.
SABLE_API_DOCS=false

# Require this in an `X-Health-Token:` header on GET /healthz. Empty leaves the
# probe open, which is the default and what a container or Kubernetes check
# expects. Set it and the answer - version, bot name, configured model - needs
# the token; the image's own healthcheck reads this variable and sends it.
SABLE_HEALTH_TOKEN=

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto are believed.
# Comma-separated IP addresses and CIDR ranges, or `*` to believe any client.
# Default is loopback only, which is right for a proxy on the same host. In
# Docker the proxy is another container, so name it or its network:
#   SABLE_TRUSTED_PROXIES=172.17.0.0/16
# Set it to nothing to trust nobody and ignore both headers. A range must have
# no host bits set (172.17.0.0/16, not 172.17.0.5/16) and a hostname is refused,
# because uvicorn would keep it as a literal that never matches a peer.
# Nothing in sable reads the client address, so this decides whether the access
# log tells the truth rather than who gets in.
SABLE_TRUSTED_PROXIES=127.0.0.1,::1

# --- Time --------------------------------------------------------------------
# The zone the assistant answers in, as an IANA name. Empty follows the host
# clock, which in a container usually means UTC. The model is told the date
# either way: without it, "what is it worth right now" is answered from
# training data, confidently and years out of date.
#   SABLE_TIMEZONE=America/New_York
SABLE_TIMEZONE=

# --- Process -----------------------------------------------------------------
SABLE_HOST=0.0.0.0
SABLE_PORT=8080
SABLE_LOG_LEVEL=INFO
