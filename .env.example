# Copy to .env and fill in. Everything is optional except the three Nextcloud
# account settings below (URL, USER, PASSWORD). Each setting is explained in
# docs/configuration.md; the comments here only say what it is for.
# A comment must sit on a line of its own: a trailing one becomes part of the value.

# --- The Nextcloud account sable is ------------------------------------------
# sable is an ordinary Nextcloud user: create one for it, invite it to the
# conversations it should be in, and give it an app password (Settings > Security
# > Devices & sessions), never its login password. An app password cannot be
# scoped, so use an account that owns nothing else.

# REQUIRED. Base URL, no trailing slash. Plain http:// to a non-local host warns.
SABLE_NEXTCLOUD_URL=https://cloud.example.org

# REQUIRED. The account's user id; also the name people @-mention.
SABLE_NEXTCLOUD_USER=sable

# REQUIRED. An app password for that user.
SABLE_NEXTCLOUD_PASSWORD=

# Seconds each long poll may wait (Talk holds one at most 60). Every poll holds a
# request slot on Nextcloud per conversation.
SABLE_POLL_TIMEOUT=30

# Seconds between looks at which conversations the account is in. At least 5.
SABLE_ROOM_REFRESH=60

# --- Chat behaviour ----------------------------------------------------------
SABLE_COMMAND_PREFIX=!

# The conversations sable serves, as TOKENS (the last part of a conversation's
# URL, e.g. a1b2c3d4), comma-separated. EMPTY MEANS EVERY CONVERSATION THE
# ACCOUNT IS IN, with a startup warning.
SABLE_ALLOWED_ROOMS=

# With SABLE_ALLOWED_ROOMS set, leave the group and public conversations that
# are neither listed nor a /notify or /hook destination.
SABLE_LEAVE_UNLISTED_ROOMS=false

# Conversations (tokens, or *) where every message goes to the model, no mention
# needed. Empty = mentions and !ai only.
SABLE_AI_ROOMS=

# Nextcloud user ids allowed to make the model answer; the admins are always
# included. EMPTY = EVERYONE.
#   SABLE_LLM_USERS=alice,bob
SABLE_LLM_USERS=

# Triggers one person may set off per minute; 0 turns it off.
SABLE_RATE_LIMIT=20

# Post answers as threaded replies to the triggering message.
SABLE_REPLY_AS_REPLY=false

# Emoji to stick on a message while the model is thinking; empty disables it.
SABLE_THINKING_REACTION=

# React to a message with this emoji and the bot answers it, threaded under it.
# Empty disables the feature.
SABLE_ASK_REACTION=⁉️

# Let only SABLE_ADMIN_USERS use that reaction (an error with no admins set).
SABLE_ASK_ADMINS_ONLY=false

# Post a short "I have no such command" hint on unknown commands.
SABLE_UNKNOWN_COMMAND_HINT=true

# Post failures back into the conversation instead of only logging them.
SABLE_REPORT_ERRORS=true

# Sign in at startup and log who Nextcloud says we are. Never fatal.
SABLE_STARTUP_CHECK=true

# Replies longer than this are clipped; Talk rejects anything over 32000.
SABLE_MAX_MESSAGE_CHARS=30000

# Model calls allowed in flight at once; 0 means no ceiling.
SABLE_MAX_CONCURRENT_REPLIES=8

# Replies allowed to WAIT for a slot once that ceiling is reached; past it new
# work is dropped. 0 means nothing may wait.
SABLE_MAX_QUEUED_REPLIES=20

# Users to ignore completely: a user id, a full actor id (users/alice) or a
# display name. Prefer ids; a display name can be changed by its owner.
SABLE_IGNORE_USERS=

# Commands only SABLE_ADMIN_USERS may run, or * for all of them. Everything not
# named stays open to everyone in the conversation, guests included.
#   SABLE_ADMIN_COMMANDS=reset,ai
SABLE_ADMIN_COMMANDS=

# The exceptions to SABLE_ADMIN_COMMANDS=*. Redundant otherwise.
#   SABLE_NORMAL_COMMANDS=help,ping,whoami
SABLE_NORMAL_COMMANDS=

# Who may run the admin commands: Nextcloud user ids, never display names.
# Required if SABLE_ADMIN_COMMANDS is set.
#   SABLE_ADMIN_USERS=maser,korren
SABLE_ADMIN_USERS=

# --- Conversation memory (in-process, lost on restart) -----------------------
SABLE_HISTORY_TURNS=12
SABLE_HISTORY_TTL=3600

# --- Model: any OpenAI /chat/completions-compatible endpoint -----------------
# OpenAI:     https://api.openai.com/v1
# Ollama:     http://localhost:11434/v1
# vLLM:       http://localhost:8000/v1
# LiteLLM:    http://localhost:4000/v1
# OpenRouter: https://openrouter.ai/api/v1
SABLE_LLM_BASE_URL=https://api.openai.com/v1
SABLE_LLM_API_KEY=
# Leave SABLE_LLM_MODEL empty to run commands only, with no model at all.
SABLE_LLM_MODEL=
SABLE_LLM_SYSTEM_PROMPT=
SABLE_LLM_TEMPERATURE=
SABLE_LLM_MAX_TOKENS=
SABLE_LLM_TIMEOUT=120
# JSON object merged into the request body last. It may not set stream or
# messages, nor the tool keys (see SABLE_LLM_TOOL_ROOMS): a startup error.
SABLE_LLM_EXTRA_BODY={}

# --- Letting the model use tools ---------------------------------------------
# openai is one request and one answer. openwebui hands the tool loop to Open
# WebUI, which runs tools with the API key's own permissions. Needs
# SABLE_LLM_API_KEY and SABLE_LLM_BASE_URL ending in /api.
SABLE_LLM_BACKEND=openai

# Workspace tools and MCP servers, as Open WebUI names them.
#   SABLE_LLM_TOOL_IDS=server:mcp:1,server:mcp:2

# Open WebUI's built-ins: web_search, code_interpreter, image_generation, memory.
#   SABLE_LLM_FEATURES=web_search

# WHERE the two settings above apply: conversation tokens, or *. EMPTY MEANS
# NOWHERE. Use a dedicated room and pair it with SABLE_LLM_USERS: anybody who can
# ask the model there can set the tools off.
#   SABLE_LLM_TOOL_ROOMS=e5f6g7h8
SABLE_LLM_TOOL_ROOMS=

# Off uses one blocking request, with no polling and no built-in tools.
SABLE_LLM_BUILTIN_TOOLS=true

# Seconds between checks while the loop is running.
SABLE_LLM_POLL_INTERVAL=2.0

# Keep the conversation each question creates, instead of deleting it.
SABLE_LLM_KEEP_CHATS=false

# Append what the answer cited.
SABLE_LLM_SHOW_SOURCES=false

# --- Inbound alerting endpoint (POST /notify) --------------------------------
# Empty disables the endpoint (it then answers 404).
SABLE_NOTIFY_TOKEN=
# Aliases so callers need not know conversation tokens:
#   SABLE_NOTIFY_ROOMS=alerts=a1b2c3d4,deploys=e5f6g7h8
SABLE_NOTIFY_ROOMS=

# --- Webhooks from other services --------------------------------------------
# Hook name to conversation (a token or a SABLE_NOTIFY_ROOMS alias), for services
# that cannot speak the /notify shape. Empty: every /hook/... answers 404.
#   SABLE_HOOKS=komodo=a1b2c3d4,grafana=e5f6g7h8
SABLE_HOOKS=

# Each hook needs its own token, in its own variable.
#   SABLE_HOOK_TOKEN_KOMODO=...

# Optional per-hook format string; without one the payload is rendered generically.
#   SABLE_HOOK_TEMPLATE_KOMODO=**{level}** {data.type}: {data.data.name}

# Largest webhook payload accepted, in bytes (256 KiB).
SABLE_MAX_HOOK_BYTES=262144

# --- File attachments on /notify ---------------------------------------------
# Folder inside the account's Files where attachments are put before sharing.
SABLE_UPLOAD_PATH=/sable

# Largest attachment /notify accepts, in bytes (25 MiB). It also sizes the largest
# request body; the container's /tmp tmpfs (compose.yaml) must stay larger.
SABLE_MAX_UPLOAD_BYTES=26214400

# --- Read by docker compose, not by sable ------------------------------------
# The host directory holding your CA bundle, mounted read-only so sable can verify
# an internal or self-signed Nextcloud. RHEL and Fedora: /etc/pki/tls/certs.
# See docs/deployment.md.
SABLE_HOST_CA_DIR=/etc/ssl/certs

# --- The HTTP surface itself -------------------------------------------------
# Serve the generated schema at /openapi.json, /docs and /redoc. Off removes the
# routes (404).
SABLE_API_DOCS=false

# Require this in an X-Health-Token header on GET /healthz. Empty leaves it open.
SABLE_HEALTH_TOKEN=

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto are believed: IPs and
# CIDR ranges, or * for any client. In Docker the proxy is not loopback, so name
# its network:
#   SABLE_TRUSTED_PROXIES=172.17.0.0/16
SABLE_TRUSTED_PROXIES=127.0.0.1,::1

# --- Time --------------------------------------------------------------------
# The zone the assistant answers in, as an IANA name. Empty follows the host clock.
#   SABLE_TIMEZONE=America/New_York
SABLE_TIMEZONE=

# --- Plugins -----------------------------------------------------------------
# A directory of plugins, each a <name>.py with a <name>_settings.yaml beside it.
# Empty turns the feature off. Mount it read-only: a plugin is code that runs on
# this host, in a worker process of its own. A plugin runs nowhere until its
# settings file lists conversation tokens.
#   SABLE_PLUGINS_DIR=/plugins
SABLE_PLUGINS_DIR=

# Seconds one plugin call may take before its worker process is killed (1-600).
SABLE_PLUGINS_TIMEOUT=30

# A plugin that fails to load stops startup (exit 2) instead of being skipped.
SABLE_PLUGINS_STRICT=false

# --- Process -----------------------------------------------------------------
SABLE_HOST=0.0.0.0
SABLE_PORT=8080
SABLE_LOG_LEVEL=INFO

# Log an access line for every successful GET /healthz (about 2,900 a day).
SABLE_LOG_HEALTH_CHECKS=false
