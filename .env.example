# Configuration reference: docs/configuration.md

# Copy to .env and fill in. Everything is optional except SABLE_BOT_SECRET.

# --- Talk bot identity -------------------------------------------------------
# The secret you passed to `occ talk:bot:install` (40-128 characters).
# Generate one with: openssl rand -hex 32
SABLE_BOT_SECRET=

# Name used for mention detection: "@sable what's the status" triggers the model.
SABLE_BOT_NAME=sable

# Your Nextcloud base URL, no trailing slash. Optional for the webhook path
# (the signed X-Nextcloud-Talk-Backend header carries it), required if you
# enable the /notify endpoint.
SABLE_NEXTCLOUD_URL=https://cloud.example.org

# Reject webhooks whose backend header is not SABLE_NEXTCLOUD_URL. Ignored when
# no URL is configured.
SABLE_PIN_BACKEND=true

# --- Chat behaviour ----------------------------------------------------------
SABLE_COMMAND_PREFIX=!

# Conversations where every message goes to the model, no mention needed.
# Comma-separated conversation tokens, or * for all. Empty = mentions only.
SABLE_AI_ROOMS=

# Post answers as threaded replies to the triggering message.
SABLE_REPLY_AS_REPLY=false

# Emoji to stick on a message while the model is thinking; empty disables it.
SABLE_THINKING_REACTION=

# Post a short "I have no such command" hint on unknown commands.
SABLE_UNKNOWN_COMMAND_HINT=true

# Post failures back into the conversation instead of only logging them.
SABLE_REPORT_ERRORS=true

# Talk hard-rejects messages over 32000 characters.
SABLE_MAX_MESSAGE_CHARS=30000

# --- Conversation memory (in-process, lost on restart) -----------------------
SABLE_HISTORY_TURNS=12
SABLE_HISTORY_TTL=3600

# --- Model: any OpenAI /chat/completions-compatible endpoint -----------------
# OpenAI:     https://api.openai.com/v1
# Ollama:     http://localhost:11434/v1
# vLLM:       http://localhost:8000/v1
# LiteLLM:    http://localhost:4000/v1
# OpenRouter: https://openrouter.ai/api/v1
SABLE_LLM_BASE_URL=https://api.openai.com/v1
SABLE_LLM_API_KEY=
# Leave SABLE_LLM_MODEL empty to run commands only, with no model at all.
SABLE_LLM_MODEL=
SABLE_LLM_SYSTEM_PROMPT=
SABLE_LLM_TEMPERATURE=
SABLE_LLM_MAX_TOKENS=
SABLE_LLM_TIMEOUT=120
# Provider-specific fields merged into the request body; these win over the above.
SABLE_LLM_EXTRA_BODY={}

# --- Inbound alerting endpoint (POST /notify) --------------------------------
# Empty disables the endpoint entirely (it then answers 404).
SABLE_NOTIFY_TOKEN=
# Friendly names so callers need not know conversation tokens:
#   SABLE_NOTIFY_ROOMS=alerts=a1b2c3d4,deploys=e5f6g7h8
SABLE_NOTIFY_ROOMS=

# --- Process -----------------------------------------------------------------
SABLE_HOST=0.0.0.0
SABLE_PORT=8080
SABLE_LOG_LEVEL=INFO
